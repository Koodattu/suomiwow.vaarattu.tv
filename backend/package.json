{
  "name": "backend",
  "version": "1.0.0",
  "description": "WoW Guild Progress Tracker Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:graph-poc": "node scripts/guild-network-poc.mjs",
    "build": "tsc",
    "migrate:ccg-collection-read-model": "node dist/scripts/migrate-ccg-collection-read-model.js",
    "repair:character-identities": "node dist/scripts/repair-character-identities.js",
    "repair:mplus-monk-specs": "node dist/scripts/repair-mythic-plus-monk-specs.js",
    "test:featured-achievements": "ts-node src/scripts/test-featured-achievements.ts",
    "start": "node --max-old-space-size=1536 dist/index.js",
    "test": "node --test -r ts-node/register \"test/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "mongoose": "^9.0.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/winston": "^2.4.4",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
