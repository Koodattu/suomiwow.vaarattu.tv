PORT=3001
MONGODB_URI=mongodb://localhost:27017/wow_guild_tracker?replicaSet=rs0

SESSION_SECRET=your-very-long-random-secret-key-change-in-production

WCL_CLIENT_ID=your_wcl_client_id
WCL_CLIENT_SECRET=your_wcl_client_secret
WCL_API_BASE=https://www.warcraftlogs.com
WCL_OAUTH_REDIRECT_URI=http://localhost:3001/api/admin/wcl-user/callback

BLIZZARD_CLIENT_ID=your_blizzard_client_id
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret

CCG_FEATURE_ENABLED=true
CCG_ENABLE_MIN_ELIGIBLE_CHARACTERS=100
CCG_ENABLE_MIN_MEDIA_READY_CHARACTERS=50
CCG_ENABLE_MIN_MEDIA_COVERAGE=0.75
CCG_MEDIA_DISCOVERY_LIMIT=1000
CCG_MEDIA_REFRESH_DAYS=14

RAIDER_IO_API_KEY=your_raider_io_api_key

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_BOT_ENABLED=true
TWITCH_BOT_REDIRECT_URI=http://localhost:3001/api/admin/twitch-bot/callback
TWITCH_BOT_SCOPES=chat:read chat:edit
TWITCH_BOT_RECONCILE_INTERVAL_SECONDS=30
TWITCH_BOT_EVENT_POLL_INTERVAL_SECONDS=30
TWITCH_BOT_PART_GRACE_SECONDS=300
TWITCH_BOT_MAX_CHANNELS=100
TWITCH_BOT_EVENT_TYPES=boss_kill,best_pull
TWITCH_BOT_DIFFICULTIES=mythic
TWITCH_BOT_EVENT_MAX_AGE_MINUTES=30

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

ADMIN_DISCORD_NAMES=name1,name2

CALCULATE_GUILD_STATISTICS_ON_STARTUP=false
CURRENT_TIER_ONLY=false
CHECK_TWITCH_STREAMS_ON_STARTUP=false
UPDATE_INACTIVE_GUILDS_ON_STARTUP=false
UPDATE_WORLD_RANKS_ON_STARTUP=false
UPDATE_GUILD_CRESTS_ON_STARTUP=false
REFETCH_RECENT_REPORTS_ON_STARTUP=false
REFRESH_CHARACTER_RANKINGS_ON_STARTUP=false
CALCULATE_TIER_LISTS_ON_STARTUP=false
CALCULATE_RAID_ANALYTICS_ON_STARTUP=false
FETCH_DEATH_EVENTS=false

# Polling intervals (in minutes)
POLLING_ACTIVE_GUILDS_MINUTES=5
POLLING_RAIDING_GUILDS_MINUTES=3
