{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "raider-constellation-poc",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/scripts/guild-network-poc.mjs"
      ],
      "port": 3015
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-ccg-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:ccg-mock"
      ],
      "port": 3100
    },
    {
      "name": "frontend-ccg-mock-user",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:ccg-mock:user"
      ],
      "port": 3100
    },
    {
      "name": "figurine-portrait-bake",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/scripts/bake-figurine-portraits.mjs",
        "3210"
      ],
      "port": 3210
    }
  ]
}
